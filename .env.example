# ============================================================
# StockSentry — 环境变量配置模板
# 复制此文件为 .env 并填写真实值，.env 已被 .gitignore 排除
# ============================================================

# ---------- 必填：数据源 ----------
TUSHARE_TOKEN=your_tushare_token_here

# ---------- 必填：AI ----------
OPENROUTER_API_KEY=sk-or-your_key_here
AI_MODEL=anthropic/claude-sonnet-4-5
AI_TIMEOUT_SECONDS=120
AI_BASE_URL=https://openrouter.ai/api/v1

# ---------- 代理（国内环境按需开启）----------
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ---------- 调度 ----------
SCHEDULER_ENABLED=true
# 每个工作日 15:30 触发跑批
SCHEDULER_CRON_HOUR=15
SCHEDULER_CRON_MINUTE=30

# ---------- 筛选阈值 ----------
SCREEN_PE_TTM_MAX=30
SCREEN_PE_DEDUCT_MAX=20
SCREEN_DV_TTM_MIN=2.0
# 总市值上限（亿元），0=不限
SCREEN_TOTAL_MV_MAX_YI=100
SCREEN_EXCLUDE_BJ=true
SCREEN_EXCLUDE_SOE=true
# 最低综合评分 0-100
SCREEN_MIN_COMPOSITE_SCORE=60

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./data/stocksentry.db

# ---------- Web ----------
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_DEBUG=false

# ---------- 预筛阈值（拉财务数据前的速度优化）----------
# 用 daily_basic 中的 pe_ttm 和 total_mv 做粗筛，跳过明显不合格的股票，
# 大幅减少财务接口请求量（pe_deduct_ttm >= pe_ttm，用 pe_ttm 作保守代理）
# 市盈率（PE_TTM）超过此值直接跳过，0 = 不限
PRESCREEN_PE_TTM_MAX=20
# 总市值（亿元）超过此值直接跳过，0 = 不限
PRESCREEN_TOTAL_MV_MAX_YI=100

# ---------- Tushare 限速 ----------
# Tushare Pro 2120 积分：每分钟最多 180 次（留 10% 余量）
TUSHARE_RATE_LIMIT=180

# ---------- 黑名单 & 次新股过滤（P0 新增）----------
# 上市不足此年限的股票视为次新股，加入黑名单（0 = 不过滤次新股）
SCREEN_MIN_LIST_YEARS=1.0

# ---------- Circuit Breaker 熔断器（P0 新增）----------
# 连续失败多少次后触发 OPEN 熔断（推荐 3~10）
BREAKER_FAILURE_THRESHOLD=5
# 熔断后冷却多少秒才允许探针请求（OPEN → HALF_OPEN）
BREAKER_COOLDOWN_SECONDS=300

# ---------- 安全阀：逐只兜底开关（P0 新增）----------
# 默认 false。开启后 VIP 接口失败时逐只拉 fina_indicator，
# 会消耗大量 API 积分（5000 只约需 30 分钟 + 海量积分），慎用。
ENABLE_FINA_LOOP_RESCUE=false

# ---------- P1：杜邦高杠杆排雷 ----------
# 权益乘数上限（eqt_multiplier），超过此值认定为高杠杆粉饰 ROE，直接剔除
# 0 = 不限
SCREEN_MAX_EQT_MULTIPLIER=3.0

# ---------- P1：盈余质量阈值 ----------
# 经营活动现金流净额 / 净利润 下限（CFO/NP）
# 低于此值说明利润可能含水分（应收款膨胀等），直接剔除
# 0 = 不限
SCREEN_MIN_CFO_TO_NP=0.5

# ---------- P1：分红连续性阈值 ----------
# 最低连续分红年数，低于此值视为分红记录不稳定，直接剔除
# 0 = 不限（允许从未分红的成长股通过）
SCREEN_MIN_DIV_CONTINUITY_YEARS=3

# 是否剔除"清仓式分红"标的
# 单年每股派现占近5年总派现 > 70% 时认定为清仓式分红
SCREEN_REJECT_CLEARANCE_DIV=true
